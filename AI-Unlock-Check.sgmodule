[Panel]
AI 解锁检测 = title="AI 解锁检测",content="点击刷新开始检测",style=info,script-name=AI-Unlock-Check,update-interval=600

[Script]
AI-Unlock-Check = type=generic,timeout=20,engine=webview,script-path=AI-Unlock-Check.js
